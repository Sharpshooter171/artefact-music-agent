# Copy placeholders into a local ignored .env; never commit real credentials.
# This approved F-03 configuration rejects other endpoints/models and paid routes.
EMPORIO_LLM_API_KEY=your-openrouter-api-key
EMPORIO_LLM_BASE_URL=https://openrouter.ai/api/v1
EMPORIO_LLM_MODEL=openrouter/free
EMPORIO_LLM_TIMEOUT=30
# OPENROUTER_API_KEY / OPENROUTER_MODEL are accepted aliases.
# Optional artifact overrides (otherwise the local generated paths are used):
# EMPORIO_CATALOG_DB=data/generated/catalog.sqlite
# EMPORIO_POLICY_INDEX=data/generated/policy_index.json
